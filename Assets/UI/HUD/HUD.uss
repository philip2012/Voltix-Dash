.hud-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.hud-panel {
    position: absolute;
    left: 24px;
    top: 24px;
    min-width: 200px;
    padding: 12px 18px;
    background-color: rgba(12, 18, 28, 0.88);
    border-radius: 6px;
}

.hud-label {
    margin: 0;
    padding: 0;
    color: rgb(255, 255, 255);
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.score-label {
    margin-top: 4px;
    color: rgb(80, 230, 255);
}
