.hud-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.hud-panel {
    position: absolute;
    left: 24px;
    top: 24px;
    min-width: 200px;
    padding: 12px 18px;
    background-color: rgba(12, 18, 28, 0.88);
    border-radius: 6px;
}

.hud-label {
    margin: 0;
    padding: 0;
    color: rgb(255, 255, 255);
    font-size: 26px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.score-label {
    margin-top: 4px;
    color: rgb(80, 230, 255);
}

.completion-overlay {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(5, 10, 20, 0.92);
}

.completion-panel {
    width: 420px;
    max-width: 90%;
    padding: 24px;
    background-color: rgb(18, 29, 46);
    border-width: 2px;
    border-color: rgb(82, 233, 245);
    border-radius: 8px;
}

.completion-title {
    margin-bottom: 18px;
    color: rgb(82, 233, 245);
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.completion-stat {
    margin-bottom: 8px;
    color: rgb(225, 245, 255);
    font-size: 24px;
    -unity-text-align: middle-center;
}

.restart-button {
    margin-top: 16px;
    height: 52px;
    border-width: 0;
    border-radius: 5px;
    background-color: rgb(82, 233, 245);
    color: rgb(11, 18, 35);
    font-size: 24px;
    -unity-font-style: bold;
}

.restart-button:hover,
.restart-button:focus {
    background-color: rgb(180, 245, 255);
}
