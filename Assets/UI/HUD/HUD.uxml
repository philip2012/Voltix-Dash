<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="HUD.uss" />
    <Style src="../Menus/Menus.uss" />
    <ui:VisualElement name="hud-overlay" class="hud-overlay" picking-mode="Ignore">
        <ui:VisualElement name="hud-panel" class="hud-panel" picking-mode="Ignore">
            <ui:Label name="health-label" text="HP: 3/3" class="hud-label" picking-mode="Ignore" />
            <ui:Label name="score-label" text="SCORE: 0000" class="hud-label score-label" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="pause-overlay" class="menu-screen pause-overlay">
        <ui:VisualElement class="menu-panel">
            <ui:Label text="PAUSED" class="menu-title" />
            <ui:Button name="resume-button" text="RESUME" class="menu-button primary-button" />
            <ui:Button name="pause-restart-button" text="RESTART" class="menu-button" />
            <ui:Button name="main-menu-button" text="MAIN MENU" class="menu-button" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="completion-overlay" class="completion-overlay">
        <ui:VisualElement class="completion-panel">
            <ui:Label text="LEVEL COMPLETE" class="completion-title" />
            <ui:Label name="final-score-label" text="SCORE: 0000" class="completion-stat" />
            <ui:Label name="final-time-label" text="TIME: 00:00.00" class="completion-stat" />
            <ui:Label name="final-deaths-label" text="DEATHS: 0" class="completion-stat" />
            <ui:Button name="next-level-button" text="NEXT LEVEL" class="restart-button" style="display: none;" />
            <ui:Button name="restart-button" text="Restart" class="restart-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
